# =============================================================================
# 서버 구동 관련 설정
# =============================================================================
# python install.py로 .env를 처음 생성하면 랜덤 값으로 자동 채워집니다.
# 이 파일을 직접 복사해 .env를 만드는 경우에는 반드시 고유한 값으로 바꾸세요.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_LANGUAGE_CODE=ko-kr

# 0: 로그인 없이 로컬 관리자 프로필로 자동 접속 (외부 접속이 없는 개인 사용 기본값)
# 1: 실제 로그인을 요구 (외부에서 접속 가능한 배포에서 사용)
# 값을 바꾼 뒤에는 재시작해야 적용됩니다: python install.py --login enable|disable
LOGIN_REQUIRED=0

# Hugging Face 토큰 (필수는 아니지만, 일부 모델 다운로드 시 필요합니다)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 서버를 실행 후 변경이 어렵습니다.
# PASSWORD는 .env를 생성할 때 자동으로 무작위 값으로 생성됩니다.
POSTGRES_DB=dotori
POSTGRES_USER=dotori
POSTGRES_PASSWORD=change-me

# POSTGRES_HOST/PORT는 docker-compose 네트워크의 서비스명에 고정된 값이므로 바꾸지 마세요.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Message Broker
CELERY_BROKER_URL=redis://redis:6379/0

# Media and Static File Storage
MEDIA_ROOT=/data/uploads
MEDIA_URL=/media/


# =============================================================================
# Parser & Chunker 설정 제어
# =============================================================================
# Parser chunk boundaries are server-wide and independent of embedding model changes.
PARSER_TOKENIZER_ID=BAAI/bge-m3
PARSER_TOKENIZER_REVISION=5617a9f

# 임베딩 입력의 고정 최대 토큰 수
EMBEDDING_MAX_TOKENS=1024       # 임베딩 입력의 고정 최대 토큰 수
EMBEDDING_TOKEN_HEADROOM=64     # 임베딩 전 컨텍스트 추가를 위한 여유분

# CHUNK_MAX_TOKENS는 EMBEDDING_MAX_TOKENS - EMBEDDING_TOKEN_HEADROOM으로 계산됩니다.
# CHUNK_MAX_TOKENS=960

# 검색 query 임베딩 최대 토큰 (미설정 시 문서 임베딩 최대 토큰 정책 사용)
# SEARCH_QUERY_EMBEDDING_MAX_TOKENS=256


# =============================================================================
# 검색 품질 튜닝 섹션
# =============================================================================
EMBEDDING_DOC_POOLING_METHOD=normalized_logsumexp   # pooling [normalized_logsumexp, max]
EMBEDDING_DOC_POOL_TAU=10.0         # normalized_logsumexp pooling 온도 (1~20, 높을 수록 max-pooling에 가까워짐)
# dense, sparse 검색 가중치 (합계 = 1.0 권장)
EMBEDDING_HYBRID_DENSE_WEIGHT=0.7
EMBEDDING_HYBRID_SPARSE_WEIGHT=0.3
EMBEDDING_HYBRID_CANDIDATE_MULTIPLIER=12    # dense 1차 후보 = top_k × candidate_multiplier
EMBEDDING_PER_NODE_CANDIDATE_CAP=4  # 문서당 dense 후보 최대 허용 개수
EMBEDDING_QUERY_SPARSE_TOP_N=32     # 쿼리 sparse 벡터에서 상위 N개 토큰만 사용
EMBEDDING_EVIDENCE_TOP_K=3          # 최종 결과에 포함할 evidence 청크 수
EMBEDDING_DOC_POOL_TOP_K=5          # 문서 점수 pooling 에 사용할 청크 수
EMBEDDING_DOC_LENGTH_PENALTY_ALPHA=0.0      # 문서 길이 패널티 강도 (0 = 패널티 없음)
EMBEDDING_EVIDENCE_CONTEXT_WINDOW=1         # evidence 에 인접 청크 몇 개를 포함할지 (0 = 해당 청크만)

# 검색/RAG contextual compression: 검색된 chunk 내부에서 질문 관련 segment만 추출
CONTEXTUAL_COMPRESSION_ENABLED=0
CONTEXTUAL_COMPRESSION_WINDOW_SIZE=2
CONTEXTUAL_COMPRESSION_MAX_SEGMENTS_PER_CHUNK=16
CONTEXTUAL_COMPRESSION_TOP_SEGMENTS=3
CONTEXTUAL_COMPRESSION_MAX_CHARS=700
CONTEXTUAL_COMPRESSION_MIN_SCORE=0.1
CONTEXTUAL_COMPRESSION_DENSE_WEIGHT=0.4
CONTEXTUAL_COMPRESSION_SPARSE_WEIGHT=0.6


# =============================================================================
# Query Understanding Tuning 섹션
# 실험적 단계이므로 사용을 권장하지 않습니다.
# =============================================================================
QUERY_UNDERSTANDING_PIPELINE_ENABLED=0
QUERY_UNDERSTANDING_PIPELINE_MAX_VALIDATION_PASSES=2
QUERY_UNDERSTANDING_LLM_ENABLED=0
QUERY_UNDERSTANDING_PARSER_INCLUDE_METADATA=1
QUERY_UNDERSTANDING_SEMAPHORE_COUNT=1
QUERY_UNDERSTANDING_SEMAPHORE_TIMEOUT=180
QUERY_UNDERSTANDING_MAX_TOKENS=512
QUERY_UNDERSTANDING_REQUEST_TIMEOUT=60
QUERY_UNDERSTANDING_TEMPERATURE=0.0
QUERY_UNDERSTANDING_TOP_P=1.0


# =============================================================================
# 로컬 RAG 모델 전용 상세 기능 제어 옵션
# =============================================================================
RAG_WORKER_CONCURRENCY=1                # RAG 답변 생성 동시 실행 수
RAG_LLM_URL=http://rag-runtime:8080     # 로컬 LLM Endpoint 기본값
RAG_MAX_TOKENS=2048                     # 답변 생성 최대 토큰 수
RAG_REQUEST_TIMEOUT=300                 # 답변 생성 타임아웃
RAG_SEARCH_TOP_K=3                      # RAG 근거 검색 결과 상위 K개
RAG_RETRIEVAL_THRESHOLD=0.25            # RAG 근거 검색 결과 임계값
RAG_EVIDENCE_LIMIT=3                    # RAG 근거 제공 청크의 개수
RAG_CONTEXT_MAX_CHARS=2000              # RAG 답변 생성을 위한 근거로 사용될 최대 글자 수
RAG_EVIDENCE_TEXT_MAX_CHARS=600         # 청크 당 프롬프트에 포함되는 최대 글자 수
RAG_TEMPERATURE=0.2                     # LLM 생성 온도
RAG_TOP_P=0.9                           # LLM 샘플링 상위 누적 확률 범위


# =============================================================================
# Email / SMPT 제어
# =============================================================================
REQUIRE_EMAIL_VERIFICATION=1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# SMTP 사용 시 아래 항목 설정 (console 백엔드일 때는 무시됨)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=change-me



# =============================================================================
# 복구 기능 제어 섹션
# =============================================================================
DOCUMENT_AI_RECOVERY_INTERVAL_SECONDS=300       # 복구 태스크 실행 주기 (초)
DOCUMENT_AI_RECOVERY_STALE_MINUTES=30           # 작업이 중지된 태스크의 대기 시간 (분)
DOCUMENT_AI_RECOVERY_PARSE_BATCH_SIZE=10        # 복구 태스크당 파싱 재큐잉 최대 건수
DOCUMENT_AI_RECOVERY_EMBED_BATCH_SIZE=10        # 복구 태스크당 임베딩 재큐잉 최대 청크 수
DOCUMENT_AI_MAX_RECOVERY_ATTEMPTS=5             # 복구 재시도 최대 횟수 (초과 시 영구 제외)
DOCUMENT_AI_WORKER_CONCURRENCY=1                # 파싱/임베딩 Celery 워커 동시 실행 수

# 검색 Celery 워커 동시 실행 수
SEARCH_WORKER_CONCURRENCY=1


# =============================================================================
# Logging
# =============================================================================
# 컨테이너 기준 로그 저장 경로입니다. docker-compose에서 ./data/logs 로 마운트됩니다.
LOG_DIR=/data/logs
OPERATION_LOG_LEVEL=WARNING         # 운영 문제 확인: operations.log
DOCUMENT_AI_LOG_LEVEL=INFO          # AI 파이프라인 흐름 확인: document_ai.log
DOTORI_OPERATION_MODE=rag



# ============================================================================
# Depricated!!! - 현재는 사용하지 않는 설정값입니다
# ============================================================================

# [Deprecated] 별도 query-parser 런타임을 쓰던 시절의 설정입니다. (실험적 기능)
# 코드 상으로는 존재하지만 실제 서비스에서는 호스트가 존재하지 않습니다.
# QUERY_UNDERSTANDING_FRONTEND_MODE=passthrough
# QUERY_UNDERSTANDING_PARSER_BASE_URL=http://rag-runtime:8080
# QUERY_UNDERSTANDING_PARSER_REQUEST_MODEL=query-parser
# QUERY_UNDERSTANDING_PARSER_MODEL=meta-llama/Llama-3.2-3B-Instruct
# QUERY_UNDERSTANDING_PARSER_SERVED_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
# QUERY_UNDERSTANDING_RUNTIME_VLLM_MAX_MODEL_LEN=2048
# QUERY_UNDERSTANDING_RUNTIME_VLLM_DTYPE=bfloat16
# QUERY_UNDERSTANDING_RUNTIME_VLLM_CPU_KVCACHE_SPACE=2
# QUERY_UNDERSTANDING_RUNTIME_VLLM_CPU_OMP_THREADS_BIND=auto
# QUERY_UNDERSTANDING_RUNTIME_VLLM_CPU_NUM_OF_RESERVED_CPU=1
